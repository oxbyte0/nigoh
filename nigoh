#!/usr/bin/env bash
# shellcheck disable=SC2054  # commas below are nmap port-list syntax inside one arg, not array separators
set -euo pipefail

NIGOH_VERSION="1.2.0"
UPDATE_RAW_URL="https://raw.githubusercontent.com/oxbyte0/nigoh/main/nigoh"

# resolved through symlinks so banners/ and self-update find the real script
REAL_SCRIPT_PATH="$(readlink -f "${BASH_SOURCE[0]}")"
SCRIPT_DIR="$(cd "$(dirname "$REAL_SCRIPT_PATH")" && pwd)"

# colors (red/gray/white only, auto-disabled unless BOTH stdout+stderr are a tty, or NO_COLOR set)
if [[ -t 1 && -t 2 && -z "${NO_COLOR:-}" ]]; then
    C_RED=$'\033[1;31m'; C_DRED=$'\033[2;31m'; C_GRAY=$'\033[2;37m'; C_WHITE=$'\033[1;37m'; C_RESET=$'\033[0m'
else
    C_RED=""; C_DRED=""; C_GRAY=""; C_WHITE=""; C_RESET=""
fi

banner() {
    [[ "${NIGOH_NO_BANNER:-0}" == "1" || "${QUIET:-0}" == "1" ]] && return 0
    printf '%s' "$C_RED" >&2
    local -a art=()
    [[ -d "$SCRIPT_DIR/banners" ]] && art=("$SCRIPT_DIR"/banners/*)
    if [[ "${#art[@]}" -gt 0 && -f "${art[0]}" ]]; then
        cat "${art[RANDOM % ${#art[@]}]}" >&2
    else
        cat >&2 <<'EOF'
        .-''-.
       /  o o  \
      |    ^    |
       \  ---  /
        '-...-'
           |
EOF
    fi
    printf '%s       N I G O H %s— nothing unseen.\n       ----+----%s\n' "$C_DRED" "$C_GRAY" "$C_RESET" >&2
}

